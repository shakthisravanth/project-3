run-button: >
  javac ProductManagement/model/*.java ProductManagement/repository/*.java ProductManagement/service/*.java ProductManagement/ui/*.java &&
  java -cp ProductManagement ui.MainUI

terminals:
  - javac ProductManagement/model/*.java ProductManagement/repository/*.java ProductManagement/service/*.java ProductManagement/ui/*.java && java -cp ProductManagement ui.MainUI

playground-view: terminal-editor
