tabs:
  - ImplementingPackages/app/Main.java
  - ImplementingPackages/numbers/One.java
  - ImplementingPackages/numbers/Two.java

run-button: >
  javac -d . ImplementingPackages/numbers/*.java ImplementingPackages/app/Main.java &&
  java -cp . app.Main

terminals:
  - javac -d . ImplementingPackages/numbers/*.java ImplementingPackages/app/Main.java && java -cp . app.Main

playground-view: terminal-editor
